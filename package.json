{
  "name": "easter-eserver-client",
  "version": "1.0.3",
  "description": "The private e-server desktop client",
  "main": "desktop/bootstrap.cjs",
  "type": "commonjs",
  "private": true,
  "author": "Easter LTD",
  "license": "UNLICENSED",
  "homepage": "https://easter.company/",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux AppImage deb pacman --x64 --publish never",
    "dist:windows": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {"electron": "44.7.2", "electron-builder": "26.15.3"},
  "build": {
    "appId": "ltd.easter.eserver",
    "productName": "e-server",
    "copyright": "Copyright © 2026 Easter LTD. All rights reserved.",
    "asar": true,
    "directories": {"output": "release"},
    "files": ["desktop/**/*", "package.json"],
    "extraResources": [{"from": "LICENSE", "to": "LICENSE.txt"}],
    "protocols": [{"name": "e-server connection", "schemes": ["e-server"]}],
    "linux": {
      "target": ["AppImage", "deb", "pacman"], "category": "Network",
      "icon": "desktop/icon.png", "executableName": "e-server-client",
      "artifactName": "Easter-e-server-Linux-${arch}.${ext}",
      "maintainer": "Easter LTD", "synopsis": "Your private e-server desktop client"
    },
    "pacman": {"depends": ["glibc", "gtk3", "nss", "nspr", "alsa-lib", "at-spi2-core", "cairo", "dbus", "expat", "glib2", "hicolor-icon-theme", "libcups", "libdrm", "libnotify", "libpulse", "libstdc++", "libx11", "libxcb", "libxcomposite", "libxdamage", "libxext", "libxfixes", "libxkbcommon", "libxrandr", "libxss", "mesa", "pango", "systemd-libs", "xdg-utils"]},
    "win": {"target": ["nsis"], "icon": "desktop/icon.png", "artifactName": "Easter-e-server-Windows-${arch}.${ext}"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "e-server"}
  }
}
